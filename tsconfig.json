{
  "compilerOptions": {
    "lib": [
      "DOM",
      "ES2018"
    ],
    "strict": true,
    "checkJs": true,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "./packages/*/lib/**/*.d.ts",
    "./packages/*/lib/**/*.js",
    "./packages/*/rules/*.js",
    "./packages/*/config/*.js",
    "./packages/*/bin/*.js"
  ],
  "exclude": [
    "./packages/*-utils"
  ]
}
