{
  "name": "bpmnlint",
  "description": "Validate your BPMN diagrams based on configurable lint rules",
  "version": "11.15.0",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib/linter": "./lib/linter.js",
    "./lib/linter.js": "./lib/linter.js",
    "./lib/resolver/node-resolver": "./lib/resolver/node-resolver.js",
    "./lib/resolver/node-resolver.js": "./lib/resolver/node-resolver.js",
    "./lib/resolver/static-resolver": "./lib/resolver/static-resolver.js",
    "./lib/resolver/static-resolver.js": "./lib/resolver/static-resolver.js",
    "./lib/support/compile-config": "./lib/support/compile-config.js",
    "./lib/support/compile-config.js": "./lib/support/compile-config.js",
    "./lib/testers/rule-tester": {
      "types": "./lib/testers/rule-tester.d.ts",
      "default": "./lib/testers/rule-tester.js"
    },
    "./lib/testers/rule-tester.js": {
      "types": "./lib/testers/rule-tester.d.ts",
      "default": "./lib/testers/rule-tester.js"
    },
    "./lib/types": {
      "types": "./lib/types.d.ts"
    },
    "./lib/testers/helper": "./lib/testers/helper.js",
    "./lib/testers/helper.js": "./lib/testers/helper.js",
    "./rules/helper": null,
    "./rules/helper.js": null,
    "./rules/*.js": "./rules/*.js",
    "./rules/*": "./rules/*.js",
    "./config/*.js": "./config/*.js",
    "./config/*": "./config/*.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "bpmnlint",
    "bpmn",
    "linter",
    "cli",
    "validation",
    "rules"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpmn-io/bpmnlint.git",
    "directory": "packages/bpmnlint"
  },
  "author": "Seif Eddine Ghezala <siffogh3@gmail.com>",
  "contributors": [
    {
      "name": "bpmn.io contributors",
      "url": "https://github.com/bpmn-io"
    }
  ],
  "engines": {
    "node": ">= 24"
  },
  "license": "MIT",
  "scripts": {
    "all": "run-s lint lint:types test-coverage test:perf",
    "lint": "eslint .",
    "lint:types": "tsc -p ../..",
    "dev": "npm test -- --watch",
    "test": "mocha --exclude \"test/integration/*/**\" --exclude \"test/performance/**\" \"test/**/*.*js\"",
    "test:perf": "mocha \"test/performance/**/*.*js\"",
    "test-coverage": "nyc --reporter=lcov --reporter=html npm test",
    "generate-docs-images": "npx @bpmn-io/bpmnlint-generate-docs-images ."
  },
  "bin": {
    "bpmnlint": "./bin/bpmnlint.js"
  },
  "dependencies": {
    "@bpmn-io/lint-core": "^0.1.0",
    "bpmn-moddle": "^10.1.0",
    "bpmnlint-utils": "^1.1.1",
    "min-dash": "^5.1.0"
  },
  "devDependencies": {
    "@bpmn-io/bpmnlint-generate-docs-images": "^1.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "config",
    "lib",
    "rules"
  ]
}
