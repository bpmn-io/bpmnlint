<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process">
    <bpmn:subProcess id="ExplicitParallel">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
      <bpmn:endEvent id="ExplicitParallelTerminate">
        <bpmn:terminateEventDefinition id="ExplicitTerminateDefinition" />
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:subProcess id="DefaultParallel">
      <bpmn:multiInstanceLoopCharacteristics />
      <bpmn:endEvent id="DefaultParallelTerminate">
        <bpmn:terminateEventDefinition id="DefaultTerminateDefinition" />
      </bpmn:endEvent>
    </bpmn:subProcess>
  </bpmn:process>
</bpmn:definitions>
